<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.tailwindcss.com"></script>
  <title>Volunteer Portal</title>
</head>
<body class="bg-amber-100">
   <a href="/" class="inline-block rounded-lg bg-blue-600 px-4 py-2 font-semibold text-white hover:bg-blue700">
    Home
  </a>
  
  <h1 class="text-2xl font-bold text-center my-6"> Volunteer</h1>

  <!-- SUCCESS / ERROR MESSAGE (sign-up, cancel, profile saved) -->
  <% if (message && message.length > 0) { %>
    <div class="max-w-xl mx-auto mb-6 px-4">
      <div class="rounded-lg bg-green-50 border border-green-300 text-green-800 px-4 py-3 font-semibold"><%= message %></div>
    </div>
  <% } %>

  <!-- PROFILE CARD: shows what's saved -->
  <section class="max-w-xl mx-auto mb-8 px-4">
    <div class="bg-white rounded-xl shadow p-6">
      <h2 class="text-2xl font-bold"><%= user.name || 'Your name' %></h2>
      <p class="text-gray-600"><%= user.jobTitle || 'No job title yet' %></p>

      <% if (user.description) { %>
        <p class="mt-3"><%= user.description %></p>
      <% } %>

      <% if (user.skills && user.skills.length) { %>
        <p class="mt-3 font-semibold">Skills</p>
        <div class="flex flex-wrap gap-2 mt-1">
          <% user.skills.forEach(s => { %>
            <span class="rounded-full bg-blue-100 text-blue-800 px-3 py-1 text-sm"><%= s %></span>
          <% }) %>
        </div>
      <% } %>

      <% if (user.interests && user.interests.length) { %>
        <p class="mt-3 font-semibold">Interests</p>
        <div class="flex flex-wrap gap-2 mt-1">
          <% user.interests.forEach(i => { %>
            <span class="rounded-full bg-amber-100 text-amber-800 px-3 py-1 text-sm"><%= i %></span>
          <% }) %>
        </div>
      <% } %>
    </div>
  </section>
 
  <div class="text-2xl font-bold text-center">
  <form action="/volunteerInfo" method="post" class="space-y-4 border-black-300 rounded-xl p-6 bg-white shadow">
    <ul>
<li>
    <label for="addName" class="block font-semibold">Volunteer Name:</label>
    <input class="mt-1 w-full max-w-md rounded-lg px-3 py-2 bg-white/80 text-gray-900 focus:outline-none focus:ring-2 focus:ring-blue-500" type="text" id="addName" name="volunteerName" value="<%= user.name || '' %>" placeholder="Name Here" required>
    </li>

       <li>
    <label for="addTitle"class="block font-semibold">Job Title:</label>
    <input class="mt-1 w-full max-w-md rounded-lg px-3 py-2 bg-white/80 text-gray-900 focus:outline-none focus:ring-2 focus:ring-blue-500" type="text" id="addTitle" name="title" value="<%= user.jobTitle || '' %>" placeholder="What do you do ?" >
    </li>
        

    <li>

    <label for="addInterests"class="block font-semibold">Interests</label>
    <input class="mt-1 w-full max-w-md rounded-md px-3 py-2 bg-white/80 text-gray-500 focus:outline-none focus:ring-2 focus:ring-blue-500" type="text" id="addInterests" name="interests" value="<%= (user.interests || []).join(', ') %>" placeholder="Hobbies" >
    </li>

    <li>

    <label for="addSkills"class="block font-semibold">Skills:</label>
    <input class="mt-1 w-full  max-w-md rounded-lg px-3 py-2 bg-white/80 text-gray-900 focus:outline-none focus:ring-2 focus:ring-blue-500" type="text" id="addSkills" name="skills" value="<%= (user.skills || []).join(', ') %>" placeholder="skills" >
    </li>
    <li>
    <label for="addDescription"class="block font-semibold">Description:</label>
    <input class="mt-1 w-full max-w-md rounded-lg px-3 py-2 bg-white/80 text-gray-900 focus:outline-none focus:ring-2 focus:ring-blue-500" type="text" id="addDescription" name="description" value="<%= user.description || '' %>" placeholder="Tell me about yourself" required>
        </li>
    <button type="submit" class="inline-block rounded-lg bg-gray-600 px-4 py-2 font-semibold text-white hover:bg-blue700"> Submit</button>
      </form>
      </div>
      <section class="max-w-xl mx-auto mt-10 px-4">
        <h2 class="text-xl font-bold mb-3"> My Shifts</h2>

          <% if (myShifts.length === 0) { %>
            <p class="text-gray-600"> No signups currently <a href="/" class="text-blue-600 underline"> Browse Events</a>
            </p>
            <% } %>

            <% myShifts.forEach(e => { %>
              <div class="border border-gray-300 bg-white rounded-lg p-3 my-2 flex justify-between items-center">
                <div>
                  <strong><%= e.title %></strong> . <%= e.date.toDateString() %><% if (e.startTime){ %> . <%= e.startTime %><%} %> <br>
                  <span class="text-sm text-gray-600"><%=e.placeId ? e.placeId.name : '' %> . <%= e.placeId ? e.placeId.address : '' %></span>
                </div>
                <form action="/events/<%= e._id %>/cancel" method="post">
                  <button class="text-red-600 hover:underline"> Cancel</button>
                </form>
              </div>
              
              
             <%} ) %>

      </section>
</body>
</html>