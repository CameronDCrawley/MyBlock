<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.tailwindcss.com"></script>
  <title>Organization Portal</title>
</head>
<body class="bg-amber-100">
  <a href="/" class="inline-block rounded-lg bg-blue-600 px-4 py-2 font-semibold text-white hover:bg-blue700">
    Home
  </a>
  
  <h1 class="text-2xl font-bold text-center my-6">Organization Portal</h1>
  
  <div class="text-2xl font-bold text-center">
  <form action="/organizationInfo" method="post"class="space-y-4 border-black-300 rounded-xl p-6 bg-white shadow">
    <ul>
<li>
  <h2>Add Event:</h2>
    <label for="addName">Organization Name:</label>
    <input class="mt-1 w-full max-w-md rounded-lg px-3 py-2 bg-white/80 text-gray-900 focus:outline-none focus:ring-2 focus:ring-blue-500" type="text"  id="addOrgName" name="organizationName" placeholder="Org" required>
    </li>

       <li>
    <label for="addEventType">Event Type:</label>
    <input class="mt-1 w-full max-w-md rounded-lg px-3 py-2 bg-white/80 text-gray-900 focus:outline-none focus:ring-2 focus:ring-blue-500" type="text"  id="addEventType" name="eventType" placeholder="ex:clothing drive , soup kitchen , check in" >
    </li>
        

    <li>

    <label for="addHours"> Hours:</label>
    <input class="mt-1 w-full max-w-md rounded-lg px-3 py-2 bg-white/80 text-gray-900 focus:outline-none focus:ring-2 focus:ring-blue-500" type="text"  id="addHours" name="hours" placeholder="Time Of Event" >
    </li>

    <li>

    <label for="addLocation">Location:</label>
    <input class="mt-1 w-full max-w-md rounded-lg px-3 py-2 bg-white/80 text-gray-900 focus:outline-none focus:ring-2 focus:ring-blue-500" type="text"  id="addLocation" name="location" placeholder="Where?" >
    </li>
    <li>
    <label for="addEventDescription">Description:</label>
    <input class="mt-1 w-full max-w-md rounded-lg px-3 py-2 bg-white/80 text-gray-900 focus:outline-none focus:ring-2 focus:ring-blue-500" type="text"  id="addEventDescription" name="description" placeholder="Brief event description" required>
        </li>
    <button type="submit" class="inline-block rounded-lg bg-gray-600 px-4 py-2 font-semibold text-white hover:bg-blue700" > Submit</button>
      </form>
      </div>
</body>
</html>