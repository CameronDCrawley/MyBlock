<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <!-- <link rel="stylesheet" href="/style.css"> -->
  <link rel="stylesheet" href="/map.css">
  <script src="https://cdn.tailwindcss.com"></script>
  <title>MyBlock Main Feed</title>
</head>
<body>
   <a href="/portal"  class="inline-block rounded-lg bg-blue-600 px-4 py-2 font-semibold text-white hover:bg-blue700">
    Profile
  </a>
<h1 class="text-2xl font-bold text-center my-6"> Find Events By You:  </h1> 

<div id="map" style="height:480px; width:100%; background:#ddd;"></div>

<section class="space-y-3">
  <h2 class="text-6xl font-bold"> Upcoming Events</h2>
  <% if (message && message.length > 0) { %>
  <div class="my-3 rounded-lg bg-green-50 border border-green-300 text-green-800 px-3 py-2"><%=message %></div>
  <% } %>
  <% if (events.length === 0) { %>
    <p class="text-gray-500"> No events at this moment.</p>
    <%} %>

    <% events.forEach( e => { %>
      <% const spotsLeft = e.spots - e.signups.length %>
      <% const signedUp = user && e.signups.some(id => id.equals(user._id)) %>

      <div class="border rounded-lg p-4 shadow-sm">
        <p class="text-sm text-gray-500">
          <%= e.date.toDateString() %><% if (e.startTime) { %> . <%= e.startTime %>-<%= e.endTime %><%} %>
        </p>
        <h3 class="font-bold text-lg"><%=e.title %></h3>
        <p class="text-sm"> <%= e.placeId ? e.placeId.name : '' %> . <%= e.placeId ? e.placeId.address: '' %></p>
        <p class="my-2"> <%= e.description %></p>
        <p class="text-sm"><%= spotsLeft %> of <%= e.spots %> spots left</p>
        <div class="flex gap-3 mt-2">
          
        <button onclick="focusEvent('<%= e._id %>') " class="text-blue-600 underline"> Show on map

        </button>

        <% if (user && user.role ==='volunteer') { %>
          <% if (signedUp) { %>
            <span class="font-semibold text-green-700"> Your signed up ✅</span>
          <form action="/events/<%= e._id %>/cancel" method="post">

            <button class="bg-green-600 text-white px-3 py-1 rounded">Cancel</button>
          </form>

          <% } else if (spotsLeft <= 0) { %>
            <span class="font-semibold text-gray-500">Full</span>
            <%} else { %>
               <form action="/events/<%= e._id %>/signup" method="post">

            <button class="bg-green-600 text-white px-3 py-1 rounded">Sign Up</button>
          </form>
            <% } %>
            <% } %>
        </div>
      </div>
      
     <% }) %>

  
</section>

