<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="style.css">
    <script src="https://cdn.tailwindcss.com"></script>
  <title>MyBlock Login Page</title>
</head>
<body>
      <h2 class="text-2xl font-bold text-center my-6 border-b-4"> MyBlock Login. </h2>

        <main class="max-w-4xl mx-auto px-4 grid gap-32 md:grid-cols-2">

    <section class="w-full md:w-120 py-20 min-h- [420px]">
     <h1 class="text-2xl font-bold text-center my-6"> <span class="fa fa-sign-in"></span>Volunteer Login </h1>

    <!-- LOGIN FORM -->
     <div class="text-2xl font-bold text-center">
    <form action="/login" method="post" id="loginForm" class="space-y-5">
        <fieldset class="flex gap-1 rounded-xl bg-slate-100 p-1">
            <span>Logging in as </span>
            <label class="flex-1">
                <input type="radio" name="role" value="volunteer">
                <%= role === 'volunteer' ? 'checked' : '' %>>
                <span class="block cursor-pointer rounded-lg py-3 text-center font-bold text-slate-600 peer-checked:bg-white peer-checked:text-[#1F4E79] PEER-CHECKED:SHADOW peer-focus-visible:ring-2 peer-focus-visible:ring-[#1F4E79]">
                    Volunteer
                        </span>
            </label>
            <label class="flex-1">
                <input type="radio" name="role" value="volunteer">
                <%= role === 'organization' ? 'checked' : '' %>>
                <span class="block cursor-pointer rounded-lg py-3 text-center font-bold text-slate-600 peer-checked:bg-white peer-checked:text-[#1F4E79] PEER-CHECKED:SHADOW peer-focus-visible:ring-2 peer-focus-visible:ring-[#1F4E79]">
                    Organization
                </span>
        </fieldset>

        <h2 class="text-2xl fon-bold">Volunteer Login</h2>

        <% if (message.length > 0) { %>
            <div class="rounded-lg border border-red-300 bg-red-50 px-3 py-2 text-red-700"><%= message %></div>
            <% } %>

        <div>
            <label for="email" class="block font-semibold mb-1">Email</label>
            <input type="email" name="email" required class="w-full rounded-lg border px-3 py-3">
        </div>

        <div>
            <label for="password" class="block font-semibold mb-1">Password</label>
            <input type="password" name="password" required class="w-full rounded-lg border px-3 py-3">
        </div>

        <button type="submit" class=" btn btn-warning btn-lg rounded-lg bg-blue-600 px-4 py-2 font-semibold text-white hover:bg-blue-700">Login</button>
    </form>
</section>
</div>
</div>
</main>
<div class="text-center mt-8 space-y-1">
    <div class="border-t pt-8 flex flex-col items-center gap-4 text-center">
    <p> New to MyBlock? <a href="/signup" class="text-amber-600  decoration-4 underline-offset-4 hover:text-purple-800">Signup Here</a></p>
    <p>Or go <a href="/"class="text-amber-600  decoration-4 underline-offset-4 hover:text-purple-800">Home</a>.</p>

    </div>


</div>
</div>
<script>
    const form = document.getElementById('loginForm')
    const title = document.getElementById('loginTitle')
    const button = document.getElementById('loginButton')

    function updateLogin(){
        const role = form.querySelector('input[name = role]: checked').value 
        const isOrg = role === 'organization'
        title.textContent = isOrg ? 'Organization Login' : 'Volunteer Login'
    }
    form.addEventListener('change',updateLogin)
    updateLogin()
</script>
</body>
</html>