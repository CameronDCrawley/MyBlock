<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.tailwindcss.com"></script>
  <title>Organization Portal</title>
</head>
<body class="bg-amber-100">
  <a href="/" class="inline-block rounded-lg bg-blue-600 px-4 py-2 font-semibold text-white hover:bg-blue700">
    Home
  </a>
  
  <h1 class="text-2xl font-bold text-center my-6">Organization Portal</h1>

  <% if (message && message.length > 0) { %>
    <div class="max-w-xl mx-auto mb-6 rounded-lg bg-red-50 border border-red-300 text-red-700 px-4 py-3 font-semibold"><%= message %></div>
  <% } %>
  
  <div class="text-2xl font-bold text-center">
  <form action="/events" method="post"class="space-y-4 border-black-300 rounded-xl p-6 bg-white shadow">
    <ul>
<li>
  <h2>Add Event:</h2>
    <label for="addName">Event Name:</label>
    <input class="mt-1 w-full max-w-md rounded-lg px-3 py-2 bg-white/80 text-gray-900 focus:outline-none focus:ring-2 focus:ring-blue-500" type="text"  id="eventName" name="event" placeholder="Org" required>
    </li>
    <li>
      <label for="placeId">Location:</label>
      <select name="placeId" id="placeId" required class="mt-1 w-full max-w-md rounded-lg px-3 py-2">
        <% places.forEach(p => { %>
        <option value="<%= p._id %>"><%= p.name %> (<%= p.address %>)</option>
        
        <%}) %>

      </select>
    </li>

       <li>
    <label for="addDate">Date:</label>
    <input class="mt-1 w-full max-w-md rounded-lg px-3 py-2 bg-white/80 text-gray-900 focus:outline-none focus:ring-2 focus:ring-blue-500" type="date"  id="eventDate" name="eventDate" placeholder="ex:clothing drive , soup kitchen , check in" >
    </li>
        

    <li>

    <label for="addStart"> Start Time:</label>
    <input class="mt-1 w-full max-w-md rounded-lg px-3 py-2 bg-white/80 text-gray-900 focus:outline-none focus:ring-2 focus:ring-blue-500" type="text"  id="startTime" name="startTime" placeholder="Time Event Starts" >
    <br>
    <label for="addEnd"> End Time:</label>
    <input class="mt-1 w-full max-w-md rounded-lg px-3 py-2 bg-white/80 text-gray-900 focus:outline-none focus:ring-2 focus:ring-blue-500" type="text"  id="endTime" name="endTime" placeholder="Time Event Ends" >
    </li>

    <li>

    <label for="addVolunteers">Volunteers Needed:</label>
    <input class="mt-1 w-full max-w-md rounded-lg px-3 py-2 bg-white/80 text-gray-900 focus:outline-none focus:ring-2 focus:ring-blue-500" type="text"  id="volunteersNeeded" name="volunteersNeeded" placeholder="Volunteers needed" >
    </li>
    <li>
    <label for="addSkills">Skills:</label>
    <input class="mt-1 w-full max-w-md rounded-lg px-3 py-2 bg-white/80 text-gray-900 focus:outline-none focus:ring-2 focus:ring-blue-500" type="text"  id="skills" name="skills" placeholder="Skills needed" required>
        </li>
         <li>
    <label for="addDescription">Description:</label>
    <input class="mt-1 w-full max-w-md rounded-lg px-3 py-2 bg-white/80 text-gray-900 focus:outline-none focus:ring-2 focus:ring-blue-500" type="text"  id="description" name="description" placeholder="Description" required>
        </li>
    <button type="submit" class="inline-block rounded-lg bg-gray-600 px-4 py-2 font-semibold text-white hover:bg-blue700" > Submit</button>
      </form>
      </div>
      <h2 class = "text-xl font-bold mt-8"> My Events</h2>
      <% myEvents.forEach(e=> { %>
        <div class ="border rounded p-3 my-2 flex justify-between items-center">
          <div>
            <strong><%= e.title %></strong> . <%= e.date.toDateString() %> <br>
            <span class="text-sm text-gray-600"> <%=e.placeId ? e.placeId.name : '' %> . <%= e.signups.length %>/<%= e.spots %> signed up</span>
            
          </div>
          <form action="/events/<%=e._id %>/edit" method="post" class="flex gap-2 mt-2">
            <input type="date" name="eventDate" value="<%= e.date.toISOString().slice(0,10)%>" class="border rounded px-2">
            <input type="text" name="startTime" value="<%= e.startTime || '' %>" class="border rounded px-2 w-24">
             <input type="text" name="endTime" value="<%= e.endTime %>" class="border rounded px-2 w-24">
              <input type="number" name="volunteersNeeded" value="<%= e.spots || '' %>" class="border rounded px-2 w-24">
              <button class="text-blue-600 hover:underline">Save edits</button>

          </form>
          <form action = "/events/<%=e._id %>/delete" method="POST">
            <button class ="text-red-600"> Delete </button>
          </form>
        </div>
    <%  }) %>
</body>
</html>